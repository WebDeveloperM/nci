server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /api/nci {
        proxy_pass https://1c.bnpz.uz/base1c/hs/ERP/GetNCI/;
        proxy_ssl_server_name on;
        proxy_set_header Host 1c.bnpz.uz;
        proxy_set_header Authorization "Basic ${NCI_AUTH_BASIC}";
        proxy_set_header Content-Type application/json;
    }

    location / {
        try_files $uri /index.html;
    }
}
